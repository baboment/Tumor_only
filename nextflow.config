// Containers (from env, or placeholder)
params.pb_container   = System.getenv('PB_SIF')   ?: '/common/sif/clara-parabricks/4.5.1.sif'
params.gatk_container = System.getenv('GATK_SIF') ?: '/common/sif/gatk/4.6.1.0.sif'

// Optional Slurm account via env/param, but default to blank in public
params.slurm_account = System.getenv('SLURM_ACCOUNT') ?: ''

// Cluster reference/resource defaults. Override these with CLI params, env vars,
// params files, or conf/local.config for non-local deployments.
params.ref                      = System.getenv('REF_FA')                       ?: '/common/db/human_ref/hg38/v0/Homo_sapiens_assembly38.fasta'
params.mills                    = System.getenv('MILLS_VCF')                    ?: '/common/db/human_ref/hg38/v0/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz'
params.dbsnp                    = System.getenv('DBSNP_VCF')                    ?: '/common/db/human_ref/hg38/v0/Homo_sapiens_assembly38.dbsnp138.vcf.gz'
params.mutect_germline_resource = System.getenv('MUTECT_GERMLINE_RESOURCE_VCF') ?: System.getenv('GNOMAD_AF_VCF') ?: '/common/db/human_ref/hg38/somatic_hg38/af-only-gnomad.hg38.vcf.gz'
params.contamination_sites_vcf  = System.getenv('CONTAMINATION_SITES_VCF')      ?: '/common/db/human_ref/hg38/somatic_hg38/small_exac_common_3.hg38.vcf.gz'
params.exome_bed                = System.getenv('EXOME_BED')                    ?: '/project/o240001_SBUFF67/ALL_FF68/exome/capture_bed/target.norm.bed'
params.exome_bait_bed           = System.getenv('EXOME_BAIT_BED')               ?: '/project/o240001_SBUFF67/ALL_FF68/exome/capture_bed/bait.norm.bed'

// NOTE: these are the CLEANED S33266436 beds - track/browser lines stripped,
// intervals merged, primary contigs only. The raw Agilent files cannot be used
// directly: pbrun's interval parser hard-fails on the UCSC header lines that
// GATK silently ignores. Regenerate with exome/code/04_prepare_bed.sh.
// Guard: bait == target silently corrupts hybrid-selection metrics.
if (params.exome_bait_bed && params.exome_bed && params.exome_bait_bed == params.exome_bed) {
  System.err.println("WARN: exome_bait_bed == exome_bed. FOLD_ENRICHMENT and MEAN_TARGET_COVERAGE from CollectHsMetrics will be wrong. Pass the Covered bed as --exome_bait_bed and the Regions bed as --exome_bed.")
}

params.mutect_pon_vcf           = System.getenv('MUTECT_PON_VCF')               ?: System.getenv('PON_VCF') ?: '/common/db/human_ref/hg38/somatic_hg38/1000g_pon.hg38.vcf.gz'
params.pon_vcf                  = System.getenv('PON_VCF')                      ?: params.mutect_pon_vcf

// ClairS-TO resources (4 population AF VCFs + PON)
params.clairs_to_pon          = System.getenv('CLAIRS_TO_PON')      ?: '/project/o240001_SBUFF67/ClairS-TO/PON/1000g-pon.sites.vcf.gz'
params.clairs_to_colorsdb     = System.getenv('CLAIRS_TO_COLORSDB') ?: '/project/o240001_SBUFF67/ClairS-TO/PON/CoLoRSdb.GRCh38.v1.1.0.deepvariant.glnexus.af-ge-0.001.vcf.gz'
params.clairs_to_dbsnp        = System.getenv('CLAIRS_TO_DBSNP')    ?: '/project/o240001_SBUFF67/ClairS-TO/PON/dbsnp.b138.non-somatic.sites.vcf.gz'
params.clairs_to_gnomad       = System.getenv('CLAIRS_TO_GNOMAD')   ?: '/project/o240001_SBUFF67/ClairS-TO/PON/gnomad.r2.1.af-ge-0.001.sites.vcf.gz'

// Tool containers
params.clairs_to_container   = System.getenv('CLAIRS_TO_SIF')   ?: '/common/sif/Clairs-TO/Clairs-TO.v0.4.2.sif'
params.deepsomatic_container = System.getenv('DEEPSOMATIC_SIF') ?: '/common/sif/deepsomatic/deepsommatic_1.10.sif'

// QC parameters
params.skip_trimming         = false
params.kraken_db             = System.getenv('KRAKEN_DB')  ?: '/common/db/microbiome_ref/kraken2_DB/PlusPF'
params.kraken_env            = System.getenv('KRAKEN_ENV') ?: 'kraken2'
params.num_gpus              = 2
params.bwa_opts              = '-Y'
params.rg_lb                 = 'lib1'
params.rg_pl                 = 'ILLUMINA'

// Annotation resources
params.snpeff_version        = System.getenv('SNPEFF_VERSION') ?: '5.2f'
params.snpeff_db             = System.getenv('SNPEFF_DB')      ?: 'hg38'
params.snpeff_jar            = System.getenv('SNPEFF_JAR') ?: ''
params.snpeff_java_mem       = '8g'
params.snpeff_extra_args     = ''
// Optional raw bcftools annotate args applied after snpEff. Example:
// --annotation_bcftools_args '-a clinvar.vcf.gz -c INFO/CLNSIG,INFO/CLNDN,INFO/CLNREVSTAT'
params.annotation_bcftools_args = ''
params.python_bin = 'python3'

// Tumor-only caller tuning
params.pipeline_preset           = 'default'
params.mutect_extra_args        = ''
params.deepsomatic_model_type   = 'WES_TUMOR_ONLY'
params.deepsomatic_fallback_model_type = 'WGS_TUMOR_ONLY'
params.deepsomatic_extra_args   = ''
params.clairs_to_platform       = 'ilmn_ssrs'
params.clairs_to_extra_args     = ''
params.mutect_low_lod           = null
params.clairs_to_snv_min_af     = null
params.clairs_to_indel_min_af   = null
params.clairs_to_min_coverage   = null
params.postfilter_snv_min_af    = null
params.postfilter_indel_min_af  = null
params.postfilter_snv_min_alt_reads = null
params.postfilter_indel_min_alt_reads = null
params.postfilter_snv_min_dp    = null
params.postfilter_indel_min_dp  = null
params.merge_min_callers        = 2

// Site-specific Apptainer binds. Override APPTAINER_BIND_ARGS directly when a
// cluster needs flags other than simple --bind path pairs.
params.apptainer_bind_paths = System.getenv('APPTAINER_BIND_PATHS') ?: '/common:/common,/project:/project,/scratch:/scratch'
def makeBindArgs = { value ->
  value ? value.toString().split(',').collect { it.trim() }.findAll { it }.collect { "--bind ${it}" }.join(' ') : ''
}
params.apptainer_bind_args = System.getenv('APPTAINER_BIND_ARGS') ?: makeBindArgs(params.apptainer_bind_paths)
def cpuContainerOptions = params.apptainer_bind_args ?: ''
def gpuContainerOptions = "--nv ${cpuContainerOptions}".trim()


// Reporting plugins
report {
  enabled = true
  file    = "results/pipeline_info/execution_report.html"
  overwrite = true
}
timeline {
  enabled = true
  file    = "results/pipeline_info/execution_timeline.html"
  overwrite = true
}
trace {
  enabled = true
  file    = "results/pipeline_info/execution_trace.txt"
  overwrite = true
}

profiles {
  slurm {
    process {
      executor = 'slurm'
      shell = ['/bin/bash', '-euo', 'pipefail']
      errorStrategy = { task.exitStatus in [104, 137, 139, 140, 143, 247, 255] ? 'retry' : 'terminate' }
      maxRetries = 2

      withLabel: 'gpu' {
        queue     = System.getenv('SLURM_GPU_PARTITION') ?: 'gpu'
        cpus      = (params.num_gpus ?: 1) > 1 ? 24 : 16
        memory    = (params.num_gpus ?: 1) > 1 ? '370 GB' : '200 GB'
        time      = '24h'
        container = params.pb_container

        // Request N GPUs, no type
        clusterOptions = (
          (params.slurm_account ? "--account ${params.slurm_account} " : "") +
          "--partition=${queue} --ntasks=1 --cpus-per-task=${cpus} " +
          "--gres=gpu:${params.num_gpus}"
        )

        // GPU passthrough to Apptainer
        containerOptions = gpuContainerOptions
        maxForks = 1
      }
      
      withLabel: 'cpu_max' {
        queue = System.getenv('SLURM_CPU_PARTITION') ?: 'compute'
        cpus = 32
        memory = '512 GB'
        time = '24h'
        clusterOptions = params.slurm_account ? "--account ${params.slurm_account}" : ''
        containerOptions = cpuContainerOptions
      }

      withLabel: 'cpu_med' {
        queue = System.getenv('SLURM_CPU_PARTITION') ?: 'compute'
        cpus = 12
        memory = '128 GB'
        time = '12h'
        clusterOptions = params.slurm_account ? "--account ${params.slurm_account}" : ''
        containerOptions = cpuContainerOptions
      }
      
      withLabel: 'cpu_low' {
        queue = System.getenv('SLURM_CPU_PARTITION') ?: 'compute'
        cpus = 4
        memory = '32 GB'
        time = '8h'
        clusterOptions = params.slurm_account ? "--account ${params.slurm_account}" : ''
        containerOptions = cpuContainerOptions
      }
    }

    singularity.enabled    = true
    singularity.autoMounts = true
    // Let users define binds at runtime (env) rather than relying on committed cluster paths.
    singularity.runOptions = (System.getenv('SINGULARITY_RUN_OPTS') ?: cpuContainerOptions)
  }
}
