/*
 * ============================================================================
 * hg19 / b37 reference profile   ->   -profile slurm,hg19
 * ============================================================================
 *
 * For samples aligned to the Broad b37 bundle (Homo_sapiens_assembly19.fasta):
 * contigs are 1..22,X,Y,MT with NO chr prefix. Do not point this profile at
 * /common/db/human_ref/GRCh37/toplevel - that is Ensembl GRCh37 with 297
 * contigs including patches, and it is not what any BAM here was aligned to.
 *
 * The somatic resources come from scripts/fetch_somatic_b37.sh; the capture
 * intervals from scripts/prepare_bed_b37.sh. Run both before using this profile.
 *
 * ---------------------------------------------------------------------------
 * TWO THINGS THAT LOOK REDUNDANT AND ARE NOT
 * ---------------------------------------------------------------------------
 * 1. pon_vcf is set explicitly, not left to inherit from mutect_pon_vcf.
 *    nextflow.config binds
 *        params.pon_vcf = System.getenv('PON_VCF') ?: params.mutect_pon_vcf
 *    at top-level load time, BEFORE profiles merge. Overriding only
 *    mutect_pon_vcf here would leave pon_vcf pointing at the hg38 PoN, and
 *    pon_vcf is what DEEPSOMATIC reads. Same reasoning for exome_bait_bed,
 *    which main.nf:18 falls back to exome_bed.
 *
 * 2. This profile overrides unconditionally, so it WINS over the REF_FA /
 *    DBSNP_VCF / MUTECT_PON_VCF style environment variables that mutact.sh and
 *    the Readme advertise. Setting REF_FA and then passing -profile hg19 will
 *    not do what it looks like it does. Edit this file instead.
 */

params {
  genome_build             = 'b37'

  // ---- reference ----------------------------------------------------------
  ref                      = '/common/db/human_ref/hg19/v0/Homo_sapiens_assembly19.fasta'
  mills                    = '/common/db/human_ref/hg19/v0/Mills_and_1000G_gold_standard.indels.b37.vcf.gz'
  dbsnp                    = '/common/db/human_ref/hg19/v0/dbsnp_138.b37.vcf.gz'

  // ---- Mutect2 somatic resources (staged by scripts/fetch_somatic_b37.sh) --
  mutect_germline_resource = '/common/db/human_ref/hg19/somatic_b37/af-only-gnomad.raw.sites.b37.vcf.gz'
  contamination_sites_vcf  = '/common/db/human_ref/hg19/somatic_b37/small_exac_common_3.b37.vcf.gz'
  mutect_pon_vcf           = '/common/db/human_ref/hg19/somatic_b37/Mutect2-exome-panel.b37.vcf.gz'
  pon_vcf                  = '/common/db/human_ref/hg19/somatic_b37/Mutect2-exome-panel.b37.vcf.gz'

  // ---- capture intervals (built by scripts/prepare_bed_b37.sh) ------------
  // Regions -> target, Covered -> bait, per the Agilent README.
  exome_bed                = '/project/o250038_ALL_MET/S31285117_hg19/b37/target.norm.b37.bed'
  exome_bait_bed           = '/project/o250038_ALL_MET/S31285117_hg19/b37/bait.norm.b37.bed'

  // ---- annotation ---------------------------------------------------------
  // GRCh37.75 is Ensembl: contigs 1..22,X,Y,MT, matching our VCFs. The other
  // hg19-era database installed on this cluster is hg19kg, which is UCSC
  // chr-prefixed and would annotate NOTHING here - silently, with exit 0.
  snpeff_db                = 'GRCh37.75'

  // ---- ClairS-TO panel of normals ----------------------------------------
  // Three entries, not four: CoLoRSdb exists only as GRCh38 and would need a
  // real liftover. main.nf builds --panel_of_normals from whichever of these
  // resolve, so a blank colorsdb is a supported configuration, not a fallback
  // to the container's built-in GRCh38 defaults.
  clairs_to_gnomad         = '/common/db/human_ref/hg19/somatic_b37/clairs_to/gnomad.af-ge-0.001.b37.sites.vcf.gz'
  clairs_to_dbsnp          = '/common/db/human_ref/hg19/somatic_b37/clairs_to/dbsnp.b138.b37.sites.vcf.gz'
  clairs_to_pon            = '/common/db/human_ref/hg19/somatic_b37/clairs_to/1000g-pon.b37.sites.vcf.gz'
  clairs_to_colorsdb       = ''
}
